FROM maven:3.9-eclipse-temurin-11 AS build
WORKDIR /build
COPY source-code/metaxk-pro ./metaxk-pro
COPY source-code/new_open_mes_server ./new_open_mes_server
RUN mvn -B -f metaxk-pro/pom.xml -DskipTests install && \
    mvn -B -f new_open_mes_server/pom.xml -DskipTests package

FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=build /build/new_open_mes_server/metaxk-server/target/metaxk-server.jar /app/app.jar
ENV TZ=Asia/Shanghai JAVA_OPTS="-Xms256m -Xmx768m"
EXPOSE 48080
CMD ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
